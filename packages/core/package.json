{
  "name": "@dita-viewer/core",
  "version": "0.2.2",
  "description": "Host-neutral DITA parsing and HTML rendering core, shared by the VS Code DITA Viewer and obsidian-dita.",
  "keywords": [
    "dita",
    "dita-ot",
    "xml",
    "documentation",
    "renderer",
    "obsidian",
    "vscode"
  ],
  "homepage": "https://github.com/aREversez/VS-Code-DITA-Viewer/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/aREversez/VS-Code-DITA-Viewer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aREversez/VS-Code-DITA-Viewer.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "author": "aREversez",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "module": "./dist-esm/index.js",
      "default": "./dist/index.js"
    },
    "./styles/dita-content.css": "./styles/dita-content.css",
    "./styles/TOKENS.md": "./styles/TOKENS.md"
  },
  "files": [
    "dist",
    "dist-esm",
    "styles",
    "!dist/**/*.map"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.esm.json && node scripts/mark-esm.cjs",
    "pretest": "node -e \"require('fs').rmSync('dist-test',{recursive:true,force:true})\" && tsc -p tsconfig.test.json",
    "test": "mocha --config .mocharc.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "sax": "^1.4.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
