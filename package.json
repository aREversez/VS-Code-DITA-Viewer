{
  "name": "dita-viewer",
  "displayName": "DITA Viewer",
  "description": "DITA reading view for VS Code — renders .dita files as formatted read-only preview",
  "version": "1.0.4",
  "publisher": "dita-viewer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aREversez/VS-Code-DITA-Viewer"
  },
  "icon": "media/icons/extension-icon.png",
  "keywords": [
    "dita",
    "xml",
    "documentation",
    "preview",
    "ditamap"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:dita",
    "onLanguage:ditamap",
    "onCustomEditor:ditaViewer.preview",
    "onCustomEditor:ditaViewer.mapPreview",
    "onCommand:ditaViewer.showRendered",
    "onCommand:ditaViewer.showMapRendered",
    "onCommand:ditaViewer.transformWithDitaOt"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "dita",
        "extensions": [
          ".dita"
        ],
        "aliases": [
          "DITA",
          "dita"
        ]
      },
      {
        "id": "ditamap",
        "extensions": [
          ".ditamap"
        ],
        "aliases": [
          "DITA Map",
          "ditamap"
        ]
      }
    ],
    "customEditors": [
      {
        "viewType": "ditaViewer.preview",
        "displayName": "DITA Reading View",
        "selector": [
          {
            "filenamePattern": "*.dita"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "ditaViewer.mapPreview",
        "displayName": "DITA Map Reading View",
        "selector": [
          {
            "filenamePattern": "*.ditamap"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "ditaViewer.showRendered",
        "title": "Open DITA Reading View",
        "icon": {
          "light": "media/icons/preview.svg",
          "dark": "media/icons/preview~dark.svg"
        }
      },
      {
        "command": "ditaViewer.showMapRendered",
        "title": "Open DITA Map Reading View",
        "icon": {
          "light": "media/icons/map-preview.svg",
          "dark": "media/icons/map-preview~dark.svg"
        }
      },
      {
        "command": "ditaViewer.transformWithDitaOt",
        "title": "DITA-OT: Transform Map…",
        "icon": {
          "light": "media/icons/transform.svg",
          "dark": "media/icons/transform~dark.svg"
        }
      }
    ],
    "keybindings": [
      {
        "command": "ditaViewer.showRendered",
        "key": "ctrl+shift+alt+d",
        "when": "editorLangId == dita || resourceExtname == .dita"
      },
      {
        "command": "ditaViewer.showMapRendered",
        "key": "ctrl+shift+alt+m",
        "when": "editorLangId == ditamap || resourceExtname == .ditamap"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "ditaViewer.showRendered",
          "when": "resourceExtname == .dita",
          "group": "navigation"
        },
        {
          "command": "ditaViewer.showMapRendered",
          "when": "resourceExtname == .ditamap",
          "group": "navigation"
        },
        {
          "command": "ditaViewer.transformWithDitaOt",
          "when": "resourceExtname == .ditamap",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "ditaViewer.showRendered",
          "when": "resourceExtname == .dita",
          "group": "navigation"
        },
        {
          "command": "ditaViewer.showMapRendered",
          "when": "resourceExtname == .ditamap",
          "group": "navigation"
        },
        {
          "command": "ditaViewer.transformWithDitaOt",
          "when": "resourceExtname == .ditamap",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "ditaViewer.showRendered",
          "when": "resourceExtname == .dita"
        },
        {
          "command": "ditaViewer.showMapRendered",
          "when": "resourceExtname == .ditamap"
        },
        {
          "command": "ditaViewer.transformWithDitaOt",
          "when": "resourceExtname == .ditamap"
        }
      ]
    },
    "configuration": {
      "title": "DITA Viewer",
      "properties": {
        "dita-viewer.customCss": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Custom CSS file paths to apply to the preview. Supports absolute paths, paths relative to workspace root, and paths relative to the DITA file directory."
        },
        "dita-viewer.cssDirectory": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Directories to scan for available CSS files. Supports absolute paths, workspace-relative paths, and document-relative paths. CSS files found here appear in the preview theme dropdown."
        },
        "dita-viewer.ditaOtPath": {
          "type": "string",
          "default": "",
          "description": "DITA-OT 安装目录的绝对路径（该目录下应有 bin/dita 或 bin\\dita.bat）。留空则自动探测 DITA_HOME 环境变量和 PATH。"
        },
        "dita-viewer.ditaOtInjectNavToolbar": {
          "type": "boolean",
          "default": true,
          "description": "（已废弃）转换完成后注入站点增强功能（导航、侧边栏等）。新版本使用转换流程中的 QuickPick 选择具体功能，此设置仅作为旧版兼容保留。"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.config.js",
    "build:dev": "node esbuild.config.js --dev",
    "watch": "node esbuild.config.js --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "mocha --config .mocharc.json",
    "test:e2e": "node esbuild.config.js && tsc -p tsconfig.e2e.json && node test-runner.cjs"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.0",
    "@types/sax": "^1.2.7",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/test-electron": "^2.4.0",
    "esbuild": "^0.24.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "mocha": "^10.8.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "sax": "^1.4.1"
  }
}
