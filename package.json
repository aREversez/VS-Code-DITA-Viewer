{
  "name": "dita-viewer",
  "displayName": "DITA Viewer",
  "description": "%extension.description%",
  "version": "1.0.8",
  "publisher": "dita-viewer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aREversez/VS-Code-DITA-Viewer"
  },
  "homepage": "https://github.com/aREversez/VS-Code-DITA-Viewer#readme",
  "bugs": {
    "url": "https://github.com/aREversez/VS-Code-DITA-Viewer/issues"
  },
  "icon": "media/icons/extension-icon.png",
  "galleryBanner": {
    "color": "#1E1E1E",
    "theme": "dark"
  },
  "keywords": [
    "dita",
    "xml",
    "ditamap",
    "documentation",
    "preview",
    "docs-as-code",
    "technical writing",
    "dita-ot",
    "oasis",
    "bookmap"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "languages": [
      {
        "id": "dita",
        "extensions": [
          ".dita"
        ],
        "aliases": [
          "DITA",
          "dita"
        ]
      },
      {
        "id": "ditamap",
        "extensions": [
          ".ditamap"
        ],
        "aliases": [
          "DITA Map",
          "ditamap"
        ]
      }
    ],
    "customEditors": [
      {
        "viewType": "ditaViewer.preview",
        "displayName": "DITA Reading View",
        "selector": [
          {
            "filenamePattern": "*.dita"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "ditaViewer.mapPreview",
        "displayName": "DITA Map Reading View",
        "selector": [
          {
            "filenamePattern": "*.ditamap"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "ditaViewer.showRendered",
        "title": "%command.showRendered.title%",
        "icon": "$(dita-preview)"
      },
      {
        "command": "ditaViewer.showSource",
        "title": "%command.showSource.title%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "ditaViewer.showMapRendered",
        "title": "%command.showMapRendered.title%",
        "icon": "$(dita-map-preview)"
      },
      {
        "command": "ditaViewer.showMapSource",
        "title": "%command.showMapSource.title%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "ditaViewer.transformWithDitaOt",
        "title": "%command.transformWithDitaOt.title%",
        "icon": "$(dita-transform)"
      },
      {
        "command": "ditaViewer.exportHtml",
        "title": "%command.exportHtml.title%",
        "icon": "$(export)"
      },
      {
        "command": "ditaViewer.mapExplorer.refresh",
        "title": "%command.mapExplorerRefresh.title%",
        "icon": "$(refresh)"
      }
    ],
    "icons": {
      "dita-preview": {
        "description": "%icon.ditaPreview.description%",
        "default": {
          "fontPath": "media/fonts/dita-viewer-icons.woff",
          "fontCharacter": "\\E900"
        }
      },
      "dita-map-preview": {
        "description": "%icon.ditaMapPreview.description%",
        "default": {
          "fontPath": "media/fonts/dita-viewer-icons.woff",
          "fontCharacter": "\\E901"
        }
      },
      "dita-transform": {
        "description": "%icon.ditaTransform.description%",
        "default": {
          "fontPath": "media/fonts/dita-viewer-icons.woff",
          "fontCharacter": "\\E902"
        }
      }
    },
    "keybindings": [
      {
        "command": "ditaViewer.showRendered",
        "key": "ctrl+shift+alt+d",
        "when": "editorLangId == dita || resourceExtname == .dita"
      },
      {
        "command": "ditaViewer.showMapRendered",
        "key": "ctrl+shift+alt+m",
        "when": "editorLangId == ditamap || resourceExtname == .ditamap"
      }
    ],
    "snippets": [
      {
        "language": "dita",
        "path": "./snippets/dita.json"
      },
      {
        "language": "ditamap",
        "path": "./snippets/ditamap.json"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "ditaViewer.mapExplorer",
          "name": "%view.mapExplorer.name%",
          "icon": "media/icons/map-preview.svg",
          "when": "resourceExtname == .dita || resourceExtname == .ditamap || ditaViewer.hasMap"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ditaViewer.mapExplorer",
        "contents": "%view.mapExplorer.welcome%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ditaViewer.mapExplorer.refresh",
          "when": "view == ditaViewer.mapExplorer",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "ditaViewer.showRendered",
          "when": "resourceExtname == .dita && activeCustomEditorId != ditaViewer.preview",
          "group": "navigation"
        },
        {
          "command": "ditaViewer.showSource",
          "when": "activeCustomEditorId == ditaViewer.preview",
          "group": "navigation"
        },
        {
          "command": "ditaViewer.showMapRendered",
          "when": "resourceExtname == .ditamap && activeCustomEditorId != ditaViewer.mapPreview",
          "group": "navigation"
        },
        {
          "command": "ditaViewer.showMapSource",
          "when": "activeCustomEditorId == ditaViewer.mapPreview",
          "group": "navigation"
        },
        {
          "command": "ditaViewer.transformWithDitaOt",
          "when": "resourceExtname == .ditamap",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "ditaViewer.showRendered",
          "when": "resourceExtname == .dita",
          "group": "navigation"
        },
        {
          "command": "ditaViewer.showMapRendered",
          "when": "resourceExtname == .ditamap",
          "group": "navigation"
        },
        {
          "command": "ditaViewer.transformWithDitaOt",
          "when": "resourceExtname == .ditamap",
          "group": "navigation"
        },
        {
          "command": "ditaViewer.exportHtml",
          "when": "resourceExtname == .dita || resourceExtname == .ditamap",
          "group": "1_export"
        }
      ],
      "commandPalette": [
        {
          "command": "ditaViewer.showRendered",
          "when": "resourceExtname == .dita"
        },
        {
          "command": "ditaViewer.showSource",
          "when": "activeCustomEditorId == ditaViewer.preview"
        },
        {
          "command": "ditaViewer.showMapRendered",
          "when": "resourceExtname == .ditamap"
        },
        {
          "command": "ditaViewer.showMapSource",
          "when": "activeCustomEditorId == ditaViewer.mapPreview"
        },
        {
          "command": "ditaViewer.transformWithDitaOt",
          "when": "resourceExtname == .ditamap"
        },
        {
          "command": "ditaViewer.exportHtml",
          "when": "resourceExtname == .dita || resourceExtname == .ditamap || activeCustomEditorId == ditaViewer.preview || activeCustomEditorId == ditaViewer.mapPreview"
        },
        {
          "command": "ditaViewer.mapExplorer.refresh",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "dita-viewer.customCss": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.customCss.description%"
        },
        "dita-viewer.cssDirectory": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.cssDirectory.description%"
        },
        "dita-viewer.ditaOtPath": {
          "type": "string",
          "default": "",
          "description": "%config.ditaOtPath.description%"
        },
        "dita-viewer.ditaOtInjectNavToolbar": {
          "type": "boolean",
          "default": true,
          "description": "%config.ditaOtInjectNavToolbar.description%"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.config.js",
    "build:dev": "node esbuild.config.js --dev",
    "watch": "node esbuild.config.js --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "check:l10n": "node scripts/check-l10n.cjs",
  "bench:book-render": "node scripts/bench-book-render.js",
    "build:icons": "node scripts/build-icon-font.js",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "mocha --config .mocharc.json",
    "test:e2e": "node esbuild.config.js && tsc -p tsconfig.e2e.json && node test-runner.cjs"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.0",
    "@types/sax": "^1.2.7",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/test-electron": "^3.1.0",
    "cheerio": "^1.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "mocha": "^11.8.0",
    "opentype.js": "^2.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.4.0",
    "sax": "^1.4.1",
    "sharp": "^0.35.3",
    "svgpath": "^2.6.0",
    "ttf2woff": "^3.0.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "brace-expansion": "^2.1.4",
    "js-yaml": "^4.3.1",
    "diff": "^8.0.3"
  }
}
