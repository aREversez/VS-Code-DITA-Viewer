{
  "name": "dita-viewer",
  "displayName": "DITA Viewer",
  "description": "%extension.description%",
  "version": "1.0.5",
  "publisher": "dita-viewer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aREversez/VS-Code-DITA-Viewer"
  },
  "homepage": "https://github.com/aREversez/VS-Code-DITA-Viewer#readme",
  "bugs": {
    "url": "https://github.com/aREversez/VS-Code-DITA-Viewer/issues"
  },
  "icon": "media/icons/extension-icon.png",
  "keywords": [
    "dita",
    "xml",
    "documentation",
    "preview",
    "ditamap"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:dita",
    "onLanguage:ditamap",
    "onCustomEditor:ditaViewer.preview",
    "onCustomEditor:ditaViewer.mapPreview",
    "onCommand:ditaViewer.showRendered",
    "onCommand:ditaViewer.showMapRendered",
    "onCommand:ditaViewer.transformWithDitaOt"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "languages": [
      {
        "id": "dita",
        "extensions": [
          ".dita"
        ],
        "aliases": [
          "DITA",
          "dita"
        ]
      },
      {
        "id": "ditamap",
        "extensions": [
          ".ditamap"
        ],
        "aliases": [
          "DITA Map",
          "ditamap"
        ]
      }
    ],
    "customEditors": [
      {
        "viewType": "ditaViewer.preview",
        "displayName": "DITA Reading View",
        "selector": [
          {
            "filenamePattern": "*.dita"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "ditaViewer.mapPreview",
        "displayName": "DITA Map Reading View",
        "selector": [
          {
            "filenamePattern": "*.ditamap"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "ditaViewer.showRendered",
        "title": "%command.showRendered.title%",
        "icon": {
          "light": "media/icons/preview.svg",
          "dark": "media/icons/preview~dark.svg"
        }
      },
      {
        "command": "ditaViewer.showSource",
        "title": "%command.showSource.title%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "ditaViewer.showMapRendered",
        "title": "%command.showMapRendered.title%",
        "icon": {
          "light": "media/icons/map-preview.svg",
          "dark": "media/icons/map-preview~dark.svg"
        }
      },
      {
        "command": "ditaViewer.showMapSource",
        "title": "%command.showMapSource.title%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "ditaViewer.transformWithDitaOt",
        "title": "%command.transformWithDitaOt.title%",
        "icon": {
          "light": "media/icons/transform.svg",
          "dark": "media/icons/transform~dark.svg"
        }
      }
    ],
    "keybindings": [
      {
        "command": "ditaViewer.showRendered",
        "key": "ctrl+shift+alt+d",
        "when": "editorLangId == dita || resourceExtname == .dita"
      },
      {
        "command": "ditaViewer.showMapRendered",
        "key": "ctrl+shift+alt+m",
        "when": "editorLangId == ditamap || resourceExtname == .ditamap"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "ditaViewer.showRendered",
          "when": "resourceExtname == .dita && activeCustomEditorId != ditaViewer.preview",
          "group": "navigation"
        },
        {
          "command": "ditaViewer.showSource",
          "when": "activeCustomEditorId == ditaViewer.preview",
          "group": "navigation"
        },
        {
          "command": "ditaViewer.showMapRendered",
          "when": "resourceExtname == .ditamap && activeCustomEditorId != ditaViewer.mapPreview",
          "group": "navigation"
        },
        {
          "command": "ditaViewer.showMapSource",
          "when": "activeCustomEditorId == ditaViewer.mapPreview",
          "group": "navigation"
        },
        {
          "command": "ditaViewer.transformWithDitaOt",
          "when": "resourceExtname == .ditamap",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "ditaViewer.showRendered",
          "when": "resourceExtname == .dita",
          "group": "navigation"
        },
        {
          "command": "ditaViewer.showMapRendered",
          "when": "resourceExtname == .ditamap",
          "group": "navigation"
        },
        {
          "command": "ditaViewer.transformWithDitaOt",
          "when": "resourceExtname == .ditamap",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "ditaViewer.showRendered",
          "when": "resourceExtname == .dita"
        },
        {
          "command": "ditaViewer.showSource",
          "when": "activeCustomEditorId == ditaViewer.preview"
        },
        {
          "command": "ditaViewer.showMapRendered",
          "when": "resourceExtname == .ditamap"
        },
        {
          "command": "ditaViewer.showMapSource",
          "when": "activeCustomEditorId == ditaViewer.mapPreview"
        },
        {
          "command": "ditaViewer.transformWithDitaOt",
          "when": "resourceExtname == .ditamap"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "dita-viewer.customCss": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.customCss.description%"
        },
        "dita-viewer.cssDirectory": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.cssDirectory.description%"
        },
        "dita-viewer.ditaOtPath": {
          "type": "string",
          "default": "",
          "description": "%config.ditaOtPath.description%"
        },
        "dita-viewer.ditaOtInjectNavToolbar": {
          "type": "boolean",
          "default": true,
          "description": "%config.ditaOtInjectNavToolbar.description%"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.config.js",
    "build:dev": "node esbuild.config.js --dev",
    "watch": "node esbuild.config.js --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "mocha --config .mocharc.json",
    "test:e2e": "node esbuild.config.js && tsc -p tsconfig.e2e.json && node test-runner.cjs"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.0",
    "@types/sax": "^1.2.7",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/test-electron": "^2.4.0",
    "esbuild": "^0.24.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "mocha": "^10.8.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.4.0",
    "sharp": "^0.35.3",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "sax": "^1.4.1"
  }
}
