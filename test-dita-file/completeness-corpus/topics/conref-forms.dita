<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic PUBLIC "-//OASIS//DTD DITA Topic//EN" "topic.dtd">
<topic id="conrefforms">
  <title>Conref fragment forms</title>
  <body>
    <p id="src">Source paragraph.</p>
    <!-- control: the full same-topic form names this topic's id -->
    <p conref="#conrefforms/src"/>
    <!-- same-topic shorthand: "." stands for the topic that holds the reference (R021) -->
    <p conref="#./src"/>
  </body>
</topic>
