<!-- dmv.ref.to.resource.only, positive: an xref to a topic that only a topicref with
     processing-role="resource-only" publishes, so the link has no target in the output. -->
<topic id="g-resource-only-pos">
  <title>Link to a resource-only topic (positive)</title>
  <body>
    <p><xref href="resource-only.dita">Resource-only topic</xref></p>
  </body>
</topic>
