  <title>Key to a topic, element id after it</title>
  <keydef keys="k-f-elemid" href="../topics/lib.dita#lib3"/>
  <topicref href="../topics/f-keyref-elemid-pos.dita"/>
  <topicref href="../topics/f-keyref-elemid-neg.dita"/>
  <topicref href="../topics/f-keyref-elemid-edge.dita"/>
</map>
