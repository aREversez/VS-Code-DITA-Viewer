<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic PUBLIC "-//OASIS//DTD DITA Topic//EN" "topic.dtd">
<!-- dmv.section.no.dup.title, boundary: two titles, one per section, one section nested in
     the other. Each section has exactly one title, so the count must not cross the nesting
     boundary and nothing should be reported. -->
<topic id="n-section-no-dup-title-edge">
  <title>One title per section, nested (boundary)</title>
  <body>
    <section>
      <title>The outer title</title>
      <p>Content of the outer section.</p>
      <section>
        <title>The nested title</title>
        <p>Content of the nested section.</p>
      </section>
    </section>
  </body>
</topic>
