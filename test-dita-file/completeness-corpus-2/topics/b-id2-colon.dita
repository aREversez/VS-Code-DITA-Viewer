<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic PUBLIC "-//OASIS//DTD DITA Topic//EN" "topic.dtd">
<!-- dmv.invalid.id.syntax.2, positive: a colon in @id. It is a legal XML Name
     character but DITA ids are normally restricted; the report decides. -->
<topic id="a:b">
  <title>Colon in a topic id (positive)</title>
  <body>
    <p>The topic id is "a:b".</p>
  </body>
</topic>
