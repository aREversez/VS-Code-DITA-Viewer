<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE map PUBLIC "-//OASIS//DTD DITA Map//EN" "map.dtd">
<!-- dmv.topichead.no.navtitle, negative: a topichead that carries a navtitle. -->
<map>
  <title>Topichead with a navigation title</title>
  <topichead>
    <topicmeta>
      <navtitle>Group title</navtitle>
    </topicmeta>
    <topicref href="../topics/ok.dita" copy-to="d1-neg-child"/>
  </topichead>
</map>
