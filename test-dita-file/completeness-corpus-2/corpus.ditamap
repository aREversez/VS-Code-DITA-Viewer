  <mapref href="maps/c-topic-no-format-neg.ditamap" format="ditamap"/>
  <mapref href="maps/c-topic-no-format-edge.ditamap" format="ditamap"/>
  <mapref href="maps/c-mapref-format-pos.ditamap" format="ditamap"/>
  <mapref href="maps/c-mapref-format-neg.ditamap" format="ditamap"/>
  <mapref href="maps/c-mapref-format-edge.ditamap" format="ditamap"/>
  <mapref href="maps/c-res-as-dita-pos.ditamap" format="ditamap"/>
  <mapref href="maps/c-res-as-dita-neg.ditamap" format="ditamap"/>
  <mapref href="maps/c-res-as-dita-edge.ditamap" format="ditamap"/>
  <mapref href="maps/c-res-as-map-pos.ditamap" format="ditamap"/>
  <mapref href="maps/c-res-as-map-neg.ditamap" format="ditamap"/>
  <mapref href="maps/c-res-as-map-edge.ditamap" format="ditamap"/>
  <mapref href="maps/c-remote-pos.ditamap" format="ditamap"/>
  <mapref href="maps/c-remote-neg.ditamap" format="ditamap"/>
  <mapref href="maps/c-remote-edge.ditamap" format="ditamap"/>
  <mapref href="maps/c-remote-no-external-pos.ditamap" format="ditamap"/>
  <mapref href="maps/c-remote-no-external-neg.ditamap" format="ditamap"/>
  <mapref href="maps/c-remote-no-external-edge.ditamap" format="ditamap"/>
  <mapref href="maps/c-remote-local-pos.ditamap" format="ditamap"/>
  <mapref href="maps/c-remote-local-neg.ditamap" format="ditamap"/>
  <mapref href="maps/c-remote-local-edge.ditamap" format="ditamap"/>
  <mapref href="maps/c-ext-scope-pos.ditamap" format="ditamap"/>
  <mapref href="maps/c-ext-scope-neg.ditamap" format="ditamap"/>
  <mapref href="maps/c-ext-scope-edge.ditamap" format="ditamap"/>
  <mapref href="maps/c-mapref-children-pos.ditamap" format="ditamap"/>
