<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE map PUBLIC "-//OASIS//DTD DITA Map//EN" "map.dtd">
<!-- Second differential corpus: reference spelling and @format/@scope probes
     (batch 1, see ../completeness-corpus/BATCH-1.md and README.md here).
     Oxygen must be run with THIS map as the only root map. -->
<map id="corpus2">
  <title>Completeness Check Corpus 2</title>

  <!-- Control, kept in every run: a reference to a file that does not exist. Both the
       extension and Oxygen report it, so a run that lacks it did not look at this map. -->
  <topicref href="topics/control-missing.dita"/>

  <topicref href="topics/ok.dita"/>

  <!-- Probes are added below, grouped by the batch-1 groups (A reference spelling,
       B keyref/id syntax, C @format/@scope, D navigation titles). -->
</map>
