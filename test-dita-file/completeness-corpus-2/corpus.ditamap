  <mapref href="maps/c-mapref-children-edge.ditamap" format="ditamap"/>
  <mapref href="maps/c-guess-dita.ditamap" format="ditamap"/>
  <mapref href="maps/c-guess-xml.ditamap" format="ditamap"/>
  <mapref href="maps/c-guess-html.ditamap" format="ditamap"/>
  <mapref href="maps/c-guess-noext.ditamap" format="ditamap"/>

  <!-- C. Topic-level probes. -->
  <topicref href="topics/c-topic-as-map-pos.dita"/>
  <topicref href="topics/c-topic-as-map-neg.dita"/>
  <topicref href="topics/c-topic-as-map-edge.dita"/>
  <topicref href="topics/c-topic-as-map-target.dita" copy-to="c-corpus-tam"/>
  <topicref href="topics/c-no-format-nondita-pos.dita"/>
  <topicref href="topics/c-no-format-nondita-neg.dita"/>
  <topicref href="topics/c-no-format-nondita-edge.dita"/>
  <topicref href="topics/c-mapref-parent.dita" copy-to="c-corpus-parent"/>
  <topicref href="topics/c-mapref-child.dita" copy-to="c-corpus-child"/>

  <!-- D. Navigation titles. -->
  <mapref href="maps/d-topichead-pos.ditamap" format="ditamap"/>
  <mapref href="maps/d-topichead-neg.ditamap" format="ditamap"/>
  <mapref href="maps/d-topichead-edge.ditamap" format="ditamap"/>
