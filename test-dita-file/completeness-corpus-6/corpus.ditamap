<!DOCTYPE map PUBLIC "-//OASIS//DTD DITA Map//EN" "map.dtd">
<!-- Sixth differential corpus: key scope resolution (R066) and the scope half of the
     duplicate rule (R008), see README.md here. A committed Oxygen report
     (oxygen-report.xml, 14 incidents) and its parity lock cover it now; re-run Oxygen
     with THIS map as the only root map whenever the corpus changes. -->
<map id="corpus6">
  <title>Completeness Check Corpus 6</title>

  <!-- Control, kept in every run: a reference to a file that does not exist. -->
  <topicref href="topics/control-missing.dita"/>

  <topicgroup keyscope="s1">
    <keydef keys="k-scoped" href="topics/t-target.dita"/>
    <topicref href="topics/o-scope-inside-neg.dita"/>
    <topicref href="topics/o-scope-shared-edge.dita"/>
  </topicgroup>
  <topicgroup keyscope="s2">
    <topicref href="topics/o-scope-shared-edge.dita"/>
  </topicgroup>
  <topicref href="topics/o-scope-outside-pos.dita"/>
  <topicref href="topics/o-scope-qualified-neg.dita"/>

  <!-- R008 duplicate probes (README.md, "The duplicate probes"): one map each. -->
  <mapref href="maps/p-dup-a-root.ditamap"/>
  <mapref href="maps/p-dup-b-group.ditamap"/>
  <mapref href="maps/p-dup-c-two-groups.ditamap"/>
  <mapref href="maps/p-dup-d-same-scope.ditamap"/>
  <mapref href="maps/p-dup-e-two-scopes.ditamap"/>
  <mapref href="maps/p-dup-f-topicref-scope.ditamap"/>

  <!-- R008 scope-shape probes, not yet run in Oxygen (README.md, "The scope shapes Oxygen has not been asked"). -->
  <mapref href="maps/p-dup-g-root-vs-scope.ditamap"/>
  <mapref href="maps/p-dup-h-nested-scope.ditamap"/>
  <mapref href="maps/p-dup-i-multi-vs-single.ditamap"/>
  <mapref href="maps/p-dup-j-multi-reordered.ditamap"/>
</map>
