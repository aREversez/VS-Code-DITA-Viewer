<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE map PUBLIC "-//OASIS//DTD DITA Map//EN" "map.dtd">
<!-- R008 shape probe (fourth report: reported twice): the topic once in keyscope="a b" and
     once in keyscope="a  b" (two spaces: the same names, written differently).
     Oxygen files the pair, so it parses the names on whitespace rather than comparing the
     attribute text; R008 needs no change. The spacing inside a keyscope therefore never
     decides whether two references are duplicates. See README.md, "The scope shapes". -->
<map id="p-dup-n-name-spacing">
  <title>p-dup-n-name-spacing</title>
  <topicgroup keyscope="a b">
    <topicref href="../topics/p-dup-n-name-spacing.dita"/>
  </topicgroup>
  <topicgroup keyscope="a  b">
    <topicref href="../topics/p-dup-n-name-spacing.dita"/>
  </topicgroup>
</map>
