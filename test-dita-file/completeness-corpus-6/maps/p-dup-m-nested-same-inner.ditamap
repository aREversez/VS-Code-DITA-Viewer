<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE map PUBLIC "-//OASIS//DTD DITA Map//EN" "map.dtd">
<!-- R008 shape probe (fourth report: silent): the topic once in s1 > x and once in s2 > x
     (the same innermost scope name, a different outer one).
     Oxygen draws nothing, so the whole chain is the identity and its innermost name alone
     is not; R008 needs no change. See README.md, "The scope shapes". -->
<map id="p-dup-m-nested-same-inner">
  <title>p-dup-m-nested-same-inner</title>
  <topicgroup keyscope="s1">
    <topicgroup keyscope="x">
      <topicref href="../topics/p-dup-m-nested-same-inner.dita"/>
    </topicgroup>
  </topicgroup>
  <topicgroup keyscope="s2">
    <topicgroup keyscope="x">
      <topicref href="../topics/p-dup-m-nested-same-inner.dita"/>
    </topicgroup>
  </topicgroup>
</map>
