<!-- R008 shape probe (fourth report: reported twice): the topic once in each of TWO
     independent keyscope="a b" groups, the same names in the same order.
     Oxygen files the pair, so the names are the identity of a scope and the element that
     declares it is not; R008 needs no change. This probe closed the last shape that rule had
     held by extension. See README.md, "The scope shapes". -->
<map id="p-dup-l-two-groups">
  <title>p-dup-l-two-groups</title>
  <topicgroup keyscope="a b">
    <topicref href="../topics/p-dup-l-two-groups.dita"/>
  </topicgroup>
  <topicgroup keyscope="a b">
    <topicref href="../topics/p-dup-l-two-groups.dita"/>
  </topicgroup>
</map>
