<!-- R008 shape probe (not yet run in Oxygen): the topic once in keyscope "a b" and once in keyscope "a" (they share a scope name).
     The extension's answer is an extrapolation of probes A-F, so the next Oxygen run
     decides it. One probe per map; see README.md, "The scope shapes Oxygen has not
     been asked". -->
<map id="p-dup-i-multi-vs-single">
  <title>p-dup-i-multi-vs-single</title>
  <topicgroup keyscope="a b">
    <topicref href="../topics/p-dup-i-multi-vs-single.dita"/>
  </topicgroup>
  <topicgroup keyscope="a">
    <topicref href="../topics/p-dup-i-multi-vs-single.dita"/>
  </topicgroup>
</map>
