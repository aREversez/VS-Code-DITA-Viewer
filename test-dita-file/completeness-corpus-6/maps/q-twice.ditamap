<!-- One map referenced twice with different keyscopes (x, y); two topics outside both reach its key by the qualified names x.k-twice and y.k-twice.
     The fifth report is silent on both: the keys are in effect in every scope that reaches the map. See README.md, "The key-scope tail". -->
<map id="q-twice">
  <title>q-twice</title>
  <topicref href="../topics/q-twice-target.dita"/>
  <mapref href="q-twice-keys.ditamap" keyscope="x"/>
  <mapref href="q-twice-keys.ditamap" keyscope="y"/>
  <topicref href="../topics/q-twice-x.dita"/>
  <topicref href="../topics/q-twice-y.dita"/>
</map>
